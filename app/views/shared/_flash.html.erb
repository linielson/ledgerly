<%# role="alert" makes screen readers announce errors at once; role="status" announces confirmations politely. %>
<%= tag.div(flash[:alert], class: "flash bg-red-50 text-red-700", role: "alert") if flash[:alert] %>
<%= tag.div(flash[:notice], class: "flash bg-green-50 text-green-700", role: "status") if flash[:notice] %>
