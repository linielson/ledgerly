<% content_for :title, "New password · Ledgerly" %>

<div class="card">
  <h1 class="heading">Update your password</h1>

  <%= render "shared/flash" %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "label" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Repeat the new password", class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Save", class: "btn-primary" %>
  <% end %>
</div>
