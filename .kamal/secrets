# Secrets referenced by config/deploy.yml. This file is committed, so it only points at environment variables;
# it never holds a value. DO NOT ENTER RAW CREDENTIALS HERE.
#
# Locally the variables come from .env (gitignored), loaded by running Kamal through dotenv:
#   bundle exec dotenv bin/kamal deploy
# In CI they come from GitHub Actions secrets. See docs/deploy.md.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
LEDGERLY_DATABASE_PASSWORD=$LEDGERLY_DATABASE_PASSWORD
